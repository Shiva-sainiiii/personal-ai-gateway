rules_version = '2';

// This gateway is server-only: all reads/writes to Firestore happen via the
// Firebase Admin SDK inside Next.js API routes (which bypasses these rules
// entirely using a service account). These rules block ALL direct client
// access, so even if your public firebaseConfig leaks, no one can read or
// write your keys/logs directly from a browser or script.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
