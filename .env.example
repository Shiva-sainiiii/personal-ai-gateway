# ============================================================
# FIREBASE ADMIN (server-side only — NEVER expose these client-side)
# Get these from: Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# ============================================================
FIREBASE_PROJECT_ID=personal-ai-gateway-5d937
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@personal-ai-gateway-5d937.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ============================================================
# ENCRYPTION — generate with: openssl rand -hex 32
# Used to encrypt provider API keys at rest in Firestore (AES-256-GCM)
# ============================================================
ENCRYPTION_KEY=replace_with_64_char_hex_string_from_openssl_rand_hex_32

# ============================================================
# MASTER KEYS — these are what YOUR other projects use to call this gateway
# Generate with: openssl rand -hex 24  (do this 3 times)
# Store the PLAIN value here only for seeding; the DB stores only the SHA-256 hash.
# Give these out to your other apps as: Authorization: Bearer <value>
# ============================================================
MASTER_KEY_TEXT=replace_me_text_master_key
MASTER_KEY_IMAGE=replace_me_image_master_key
MASTER_KEY_AUDIO=replace_me_audio_master_key

# ============================================================
# ADMIN PANEL PASSWORD (protects /api/admin/* routes + dashboard)
# ============================================================
ADMIN_PASSWORD=choose_a_strong_password

# ============================================================
# CRON SECRET — protects /api/cron/cleanup-logs from being triggered
# by anyone who finds the URL. Generate with: openssl rand -hex 16
# Vercel automatically sends this as a Bearer token on scheduled cron runs.
# ============================================================
CRON_SECRET=replace_me_cron_secret

# ============================================================
# WEBHOOK ALERTING (OPTIONAL) — get pinged when a provider goes fully down
# (every key for it disabled) and when it recovers. Leave both blank to
# disable alerting entirely — nothing else in the app depends on these.
# Set Telegram, Discord, or both — whichever you actually check.
#
# Telegram: message @BotFather on Telegram to create a bot and get a token.
# Then message your new bot once, and fetch https://api.telegram.org/bot<TOKEN>/getUpdates
# to find your chat_id in the response.
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# ============================================================
# PROVIDER API KEYS — paste your 25 keys here for the seed script.
# Format: PROVIDER_ACCOUNTLABEL_KEY
# The seed script (scripts/seed-keys.mjs) reads these, encrypts them,
# and writes one Firestore doc per key. After seeding, you can delete
# these from Vercel env vars if you want — the gateway reads from Firestore.
# ============================================================
OPENROUTER_ACC1_KEY=
OPENROUTER_ACC2_KEY=
OPENROUTER_ACC3_KEY=
OPENROUTER_ACC4_KEY=

GOOGLE_AI_ACC1_KEY=
GOOGLE_AI_ACC2_KEY=
GOOGLE_AI_ACC3_KEY=
GOOGLE_AI_ACC4_KEY=

GROQ_ACC1_KEY=
GROQ_ACC2_KEY=
GROQ_ACC3_KEY=
GROQ_ACC4_KEY=

CEREBRAS_ACC1_KEY=
CEREBRAS_ACC2_KEY=
CEREBRAS_ACC3_KEY=
CEREBRAS_ACC4_KEY=

CLOUDFLARE_ACC1_KEY=
CLOUDFLARE_ACC1_ACCOUNT_ID=
CLOUDFLARE_ACC2_KEY=
CLOUDFLARE_ACC2_ACCOUNT_ID=
CLOUDFLARE_ACC3_KEY=
CLOUDFLARE_ACC3_ACCOUNT_ID=
CLOUDFLARE_ACC4_KEY=
CLOUDFLARE_ACC4_ACCOUNT_ID=

# Pollinations — dedicated free image-generation provider (primary for /api/v1/image).
# Get a key at https://enter.pollinations.ai (sk_... or pk_...). A key is OPTIONAL —
# Pollinations works with zero keys on its free tier — but adding one raises your
# rate limit and removes the watermark. Only ACC1 is normally needed (single account).
POLLINATIONS_ACC1_KEY=
POLLINATIONS_ACC2_KEY=
POLLINATIONS_ACC3_KEY=
POLLINATIONS_ACC4_KEY=
